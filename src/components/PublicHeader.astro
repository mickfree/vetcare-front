---
interface Props {
  current?: string;
}

const { current = "" } = Astro.props;
---

<header class="public-header">
  <div class="page-shell header-inner">
    <a class="brand" href="/" aria-label="VetCare, ir al inicio">
      <span class="brand-mark"><i class="ti ti-paw-filled"></i></span>
      <span>VetCare</span>
    </a>

    <nav aria-label="Navegación principal">
      <a class:list={[{ active: current === "inicio" }]} href="/#servicios"
        >Servicios</a
      >
      <a href="/#como-funciona">Cómo funciona</a>
      <a href="/#cuidado">Nuestro cuidado</a>
    </nav>

    <div class="header-actions">
      <a class="login-link" href="/login">Ingresar</a>
      <a class="pill-button pill-button--small" href="/register"
        >Crear cuenta <i class="ti ti-arrow-up-right"></i></a
      >
    </div>

    <a class="mobile-login icon-button" href="/login" aria-label="Ingresar">
      <i class="ti ti-user"></i>
    </a>
  </div>
</header>

<style>
  .public-header {
    padding: 24px 0;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-ink-black);
    font-size: 20px;
    font-weight: 500;
    text-decoration: none;
  }
  .brand-mark {
    display: inline-flex;
    width: 38px;
    height: 38px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--color-blush-peach);
    color: var(--color-sienna-brown);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  nav a,
  .login-link {
    color: var(--color-ink-black);
    font-size: 14px;
    text-decoration: none;
  }
  nav a:hover,
  nav a.active,
  .login-link:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .mobile-login {
    display: none;
    text-decoration: none;
  }
  @media (max-width: 800px) {
    nav,
    .header-actions {
      display: none;
    }
    .mobile-login {
      display: inline-flex;
    }
  }
</style>
