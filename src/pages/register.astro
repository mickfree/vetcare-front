---
import AuthLayout from "@/layouts/AuthLayout.astro";
import "@/styles/pages/register.css";
---

<AuthLayout
  title="Crear cuenta — VetCare"
  description="Crea tu cuenta gratuita en VetCare."
  heading="Empecemos por ti."
  intro="Crea tu cuenta y tendrás todo listo para registrar a tus mascotas."
>
  <form id="register-form" class="auth-form">
    <div id="register-error" class="form-error" role="alert"></div>
    <div class="two-cols">
      <div class="field">
        <label for="first_name">Nombre</label><input
          id="first_name"
          name="first_name"
          autocomplete="given-name"
          placeholder="María"
          required
        />
      </div>
      <div class="field">
        <label for="last_name">Apellido</label><input
          id="last_name"
          name="last_name"
          autocomplete="family-name"
          placeholder="Torres"
          required
        />
      </div>
    </div>
    <div class="field">
      <label for="username">Usuario</label><input
        id="username"
        name="username"
        autocomplete="username"
        placeholder="maria.torres"
        required
      />
    </div>
    <div class="field">
      <label for="email">Correo electrónico</label><input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        placeholder="maria@ejemplo.com"
        required
      />
    </div>
    <div class="field">
      <label for="password">Contraseña</label><input
        id="password"
        name="password"
        type="password"
        minlength="8"
        autocomplete="new-password"
        placeholder="Mínimo 8 caracteres"
        required
      />
    </div>
    <details>
      <summary
        >Agregar teléfono y dirección <i class="ti ti-chevron-down"
        ></i></summary
      ><div class="optional-fields">
        <div class="field">
          <label for="phone">Teléfono</label><input
            id="phone"
            name="phone"
            autocomplete="tel"
            placeholder="999 888 777"
          />
        </div><div class="field">
          <label for="address">Dirección</label><input
            id="address"
            name="address"
            autocomplete="street-address"
            placeholder="Av. Principal 123"
          />
        </div>
      </div>
    </details>
    <label class="terms"
      ><input type="checkbox" required />
      <span
        >Acepto el tratamiento de mis datos para gestionar mi cuenta VetCare.</span
      ></label
    >
    <button class="pill-button submit-button" type="submit"
      >Crear mi cuenta <i class="ti ti-arrow-right"></i></button
    >
    <p class="switch-copy">
      ¿Ya tienes una cuenta? <a href="/login">Ingresa aquí →</a>
    </p>
  </form>
</AuthLayout>

<script src="../lib/pages/register.ts"></script>

